<?xml version="1.0" encoding="utf-8"?>
<androidx.slidingpanelayout.widget.SlidingPaneLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/fileExplorerPane"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceVariant">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fileExplorerContainer"
            android:name="com.example.personalcustomide.FileExplorerFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/colorBackground">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="0dp"
                android:layout_height="@dimen/toolbar_height"
                android:background="?attr/colorSurface"
                android:elevation="2dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/tabContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <ImageButton
                        android:id="@+id/btnReload"
                        android:layout_width="@dimen/icon_button_size"
                        android:layout_height="@dimen/icon_button_size"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_rotate"
                        android:contentDescription="Reload"
                        app:tint="?attr/colorOnSurface" />

                    <ImageButton
                        android:id="@+id/btnNewTab"
                        android:layout_width="@dimen/icon_button_size"
                        android:layout_height="@dimen/icon_button_size"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_add"
                        android:contentDescription="New Tab"
                        app:tint="?attr/colorOnSurface" />

                    <ImageButton
                        android:id="@+id/btnFind"
                        android:layout_width="@dimen/icon_button_size"
                        android:layout_height="@dimen/icon_button_size"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_search"
                        android:contentDescription="Find"
                        app:tint="?attr/colorOnSurface" />

                    <ImageButton
                        android:id="@+id/btnUndo"
                        android:layout_width="@dimen/icon_button_size"
                        android:layout_height="@dimen/icon_button_size"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_undo"
                        android:contentDescription="Undo"
                        android:enabled="false"
                        android:alpha="0.38"
                        app:tint="?attr/colorOnSurface" />

                    <ImageButton
                        android:id="@+id/btnRedo"
                        android:layout_width="@dimen/icon_button_size"
                        android:layout_height="@dimen/icon_button_size"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_redo"
                        android:contentDescription="Redo"
                        android:enabled="false"
                        android:alpha="0.38"
                        app:tint="?attr/colorOnSurface" />

                    <ImageButton
                        android:id="@+id/btnSettings"
                        android:layout_width="@dimen/icon_button_size"
                        android:layout_height="@dimen/icon_button_size"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_preferences"
                        android:contentDescription="Settings"
                        app:tint="?attr/colorOnSurface" />

                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>

            <com.example.personalcustomide.EditorView
                android:id="@+id/editorView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="?attr/colorSurface"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:layout_constraintTop_toBottomOf="@id/toolbar"
                app:layout_constraintBottom_toTopOf="@id/bottomBar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.bottomappbar.BottomAppBar
                android:id="@+id/bottomBar"
                android:layout_width="0dp"
                android:layout_height="@dimen/bottom_panel_height"
                android:background="?attr/colorSurfaceVariant"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/bottomStatusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ready"
                        android:textSize="@dimen/text_sm"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingHorizontal="@dimen/spacing_md" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGitStatus"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status"
                        android:textSize="@dimen/text_sm"
                        android:minWidth="0dp"
                        android:paddingHorizontal="@dimen/spacing_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGitCommit"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Commit"
                        android:textSize="@dimen/text_sm"
                        android:minWidth="0dp"
                        android:paddingHorizontal="@dimen/spacing_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGitPush"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Push"
                        android:textSize="@dimen/text_sm"
                        android:minWidth="0dp"
                        android:paddingHorizontal="@dimen/spacing_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCloneRepo"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clone"
                        android:textSize="@dimen/text_sm"
                        android:minWidth="0dp"
                        android:paddingHorizontal="@dimen/spacing_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCreatePython"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+Python"
                        android:textSize="@dimen/text_sm"
                        android:minWidth="0dp"
                        android:paddingHorizontal="@dimen/spacing_sm" />

                </LinearLayout>
            </com.google.android.material.bottomappbar.BottomAppBar>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</androidx.slidingpanelayout.widget.SlidingPaneLayout>
